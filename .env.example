# Copy this file to ".env" (setup.bat does it for you) and fill in your free key. See SETUP.md.

# ---- The agent's brain: a free hosted model (default: Groq) ----
GROQ_API_KEY=your-key-here            # free at https://console.groq.com  (no credit card)
# BOARDBOT_MODEL=openai/gpt-oss-120b   # default, strong. Faster/lighter: openai/gpt-oss-20b
# BOARDBOT_TEMPERATURE=0.2

# Other free providers (same code): uncomment one block
# BOARDBOT_PROVIDER=gemini
# GEMINI_API_KEY=...
# BOARDBOT_PROVIDER=cerebras
# CEREBRAS_API_KEY=...
# BOARDBOT_PROVIDER=openrouter
# OPENROUTER_API_KEY=...

# ---- Dates ----
# BOARDBOT_TODAY=real            # default is a fixed demo date (2026-10-06) so the sample transcripts stay valid; "real" = system date
# BOARDBOT_TIMEZONE=Asia/Kolkata # used for calendar events

# ---- Real task board: Jira Cloud (see INTEGRATIONS.md) ----
# BOARDBOT_TASKS=jira            # default: local demo database
# BOARDBOT_JIRA_BASE_URL=https://YOURSITE.atlassian.net
# BOARDBOT_JIRA_EMAIL=you@gmail.com
# BOARDBOT_JIRA_TOKEN=your-api-token
# BOARDBOT_JIRA_PROJECT=DEMO
# BOARDBOT_JIRA_ISSUE_TYPE=Task

# ---- Real calendar: Google Calendar (see INTEGRATIONS.md) ----
# BOARDBOT_CALENDAR=google       # default: local demo database
# BOARDBOT_GOOGLE_CREDENTIALS=google_credentials.json
# BOARDBOT_GOOGLE_TOKEN=google_token.json
